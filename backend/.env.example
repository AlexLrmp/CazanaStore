# Copia este archivo como backend/.env y edita localmente. Nunca lo subas a GitHub.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cazana_store
# Alternativa: URI privada de tu cluster MongoDB Atlas.
# MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>/cazana_store?retryWrites=true&w=majority
WHATSAPP_NUMBER=51986803872
WHATSAPP_CONTACT_NAME=Percy
# Activa TRUST_PROXY=1 solo si el despliegue usa un proxy de confianza.
TRUST_PROXY=0
# CAZANA-FASE-3-3: recuperación de contraseña
# Para probar LOCALMENTE sin enviar correos: RESET_DEV_LINKS=1 (enlace solo en la terminal, NO para producción)
RESET_DEV_LINKS=0
PUBLIC_SITE_URL=http://localhost:3000
# Para envío real: crea una cuenta en Resend y verifica el dominio de envío.
# RESEND_API_KEY=reemplazar_en_el_env_privado
# RESET_MAIL_FROM=Cazana Store <seguridad@tudominio.com>
